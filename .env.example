APP_PORT=8080

POSTGRES_DB=flower_details
POSTGRES_USER=flower_details
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379

# Use at least 32 random bytes. Do not reuse this example value.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
JWT_ISSUER=flower-details-api
JWT_AUDIENCE=flower-details-web

# HTTPS frontend origins, separated by commas when needed.
CORS_ALLOWED_ORIGINS=https://app.example.com
AUTH_COOKIE_SAME_SITE=Lax

# Set only when the API is behind a reverse proxy that appends X-Forwarded-For.
# Values accept IPs or CIDR ranges, separated by commas.
TRUSTED_PROXY_ADDRESSES=
